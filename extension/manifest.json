{
  "manifest_version": 3,
  "name": "DSH Bridge",
  "version": "1.2.0",
  "description": "DSH 原生浏览器控制桥：装一次永久可用，不需要点 Connect",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "alarms",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}

{
  "name": "dsh-chrome-bridge",
  "version": "1.0.0",
  "description": "DSH plugin: native browser_* tools that drive the Chrome you are already using — over native messaging + CDP. No WebSocket, no port, no Connect button.",
  "type": "module",
  "license": "MIT",
  "author": "OrderG-X",
  "homepage": "https://github.com/OrderG-X/dsh-chrome-bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrderG-X/dsh-chrome-bridge.git",
    "directory": "plugin"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser",
    "chrome",
    "cdp",
    "chrome-devtools-protocol",
    "native-messaging",
    "browser-automation",
    "agent"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "package.json"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "Chrome Bridge",
    "description": "原生 browser_* 工具，直接操作用户正在用的 Chrome（native messaging + CDP）"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

{
  "name": "dsh-chrome-bridge",
  "version": "1.15.2",
  "description": "DSH plugin: native browser_* tools that drive the Chrome you are already using, over native messaging + CDP. No WebSocket, no port, no Connect button. The native host and the MV3 extension ship inside this package and are installed automatically on first load; the one step left is adding the DSH Bridge extension to Chrome, from the Chrome Web Store or as the bundled unpacked copy. Until then browser_* tools fail loudly with those exact steps.",
  "type": "module",
  "license": "MIT",
  "author": "OrderG-X",
  "homepage": "https://github.com/OrderG-X/dsh-chrome-bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrderG-X/dsh-chrome-bridge.git",
    "directory": "plugin"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser",
    "chrome",
    "cdp",
    "chrome-devtools-protocol",
    "native-messaging",
    "browser-automation",
    "agent"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "setup.js",
    "image-guard.js",
    "refs.js",
    "devtools.js",
    "nav.js",
    "drag.js",
    "download.js",
    "panel.js",
    "cordis.patch.yml",
    "client.js",
    "locale",
    "icon.svg",
    "vendor",
    "package.json"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}

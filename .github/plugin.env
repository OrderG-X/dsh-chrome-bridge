# 这个仓库的发版设置（工作流读它；其余文件由 dsh-plugins/_ci/sync.sh 同步）
PKG_DIR=plugin
ASSETS=dsh-chrome-bridge.tgz
TEST_CMD=node scratch/test-setup.mjs && node scratch/test-groups.mjs && node scratch/test-image-guard.mjs && node scratch/test-win.mjs && node scratch/test-download.mjs
# 真机端到端（CI 在 macOS / Windows / Linux 上跑：自动安装 → 真浏览器加载扩展 → 宿主连上 → 读真页面；另装进真 DSH 跑一遍；Windows 多测几种情况）
E2E_CMD=bash scratch/e2e.sh
# 日常 DSH 实跑必须通过的系统（空格分隔：macOS Windows）；其余系统的结果只作参考
PLATFORMS=macOS Windows

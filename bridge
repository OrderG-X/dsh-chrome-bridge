#!/bin/bash
# bridge —— DSH Bridge 的统一管理入口
#
#   ./bridge install     首次安装（写注册文件、装 cb、提示加载扩展）
#   ./bridge setup       引导式安装：能自动的都自动，只剩 Chrome 里那一次点选，装好自动检测
#   ./bridge update      改完代码同步到已装目录，并热重载扩展（不用点 Chrome 刷新）
#   ./bridge status      仓库版本 / 已装版本 / 实际运行版本 + 连接状态
#   ./bridge reload      只热重载扩展
#   ./bridge logs        宿主日志 + 扩展日志
#   ./bridge test        端到端自检
#   ./bridge pack        打出发版用 tgz（附加到 GitHub Release，目录条目靠它预构建安装）
#   ./bridge store-pack  打出 Chrome 应用商店用的 zip（扩展本体，去掉 manifest 的 key）
#   ./bridge uninstall   卸载
#
# 装了 DSH 技能 ~/.dsh/skills/browser/SKILL.md —— 新会话会自动知道 cb 怎么用

set -uo pipefail

REPO="$(cd "$(dirname "$0")" && pwd)"
VENDOR="$REPO/plugin/vendor"
EXT_DIR="$HOME/dsh-bridge-extension"
BRIDGE="$HOME/.dsh/chrome-bridge"
CB="$HOME/.dsh/bin/cb"

manifest_ver() { node -e 'console.log(require(process.argv[1]).version)' "$1" 2>/dev/null || echo "${2:-?}"; }
repo_ver() { manifest_ver "$VENDOR/extension/manifest.json"; }
inst_ver() { manifest_ver "$EXT_DIR/manifest.json" 未安装; }

case "${1:-help}" in
  install)
    exec "$REPO/install.sh"
    ;;

  setup)
    # 引导式安装：能自动的都自动（宿主 + 注册 + 插件），只剩 Chrome 里那一次点选。
    # 那一下替不了（Chrome 137+ 没有 --load-extension，商店也不收 debugger 权限），
    # 所以至少把用户送到那一下面前：页面帮你打开、路径帮你复制，装好自动检测。
    echo "═══ dsh-chrome-bridge 引导安装 ═══"
    node -e 'import(process.argv[1]).then(m => {
      const r = m.ensureInstalled()
      console.log(r.ok ? "① 宿主与 native 注册已就位" : "① 自动安装没成：" + r.reason)
    })' "$REPO/plugin/setup.js"
    if [ -S /tmp/dsh-bridge.sock ]; then
      echo "② 扩展已连上 —— 不用再点任何东西 ✅"
      "$CB" status
      exit 0
    fi
    printf '%s\n' "$EXT_DIR" | pbcopy
    OPENED=0
    if pgrep -x "Google Chrome" >/dev/null; then
      open -g -a "Google Chrome" "chrome://extensions" && OPENED=1
    fi
    echo
    echo "② 还差一次点选（一辈子就一次）："
    if [ "$OPENED" = 1 ]; then
      echo "   · 已经帮你在 Chrome 里打开了 chrome://extensions（后台标签页，切过去）"
    else
      echo "   · 先打开 Chrome，访问 chrome://extensions"
    fi
    echo "   · 右上角打开「开发者模式」"
    echo "   · 点左上「加载已解压的扩展程序」"
    echo "   · 文件框里：⌘⇧G → ⌘V（路径已在剪贴板）→ 回车 → 回车"
    echo "     文件夹：$EXT_DIR"
    echo
    echo "我在这儿等（最多 3 分钟，⌃C 可退出）…"
    for _ in $(seq 1 180); do
      if [ -S /tmp/dsh-bridge.sock ]; then
        echo
        echo "✅ 搞定，扩展连上了："
        "$CB" status
        exit 0
      fi
      sleep 1
    done
    echo
    echo "⏳ 还没连上，多半是这两条："
    echo "   · 「开发者模式」没打开（右上角那个开关）"
    echo "   · 选的文件夹不对（要选 $EXT_DIR）"
    echo "再跑一次 ./bridge setup 即可。"
    ;;

  update)
    echo "同步代码 → $EXT_DIR"
    mkdir -p "$EXT_DIR" "$BRIDGE/host" "$HOME/.dsh/bin"
    cp -R "$VENDOR/extension/." "$EXT_DIR/"
    cp "$VENDOR/host/host.js" "$VENDOR/host/run.sh" "$BRIDGE/host/"
    cp "$VENDOR/in-page-cursor.js" "$HOME/.dsh/chrome-cursor/in-page-cursor.js"
    cp "$VENDOR/cb" "$CB"
    mkdir -p "$HOME/.dsh/skills/browser"
    cp "$VENDOR/skill/SKILL.md" "$HOME/.dsh/skills/browser/SKILL.md"
    chmod +x "$CB" "$BRIDGE/host/run.sh"
    echo "热重载扩展（v$(repo_ver)）…"
    "$CB" reload 2>/dev/null || echo "  扩展没在跑，下次打开 Chrome 自动加载新代码"
    sleep 1.5
    "$CB" version 2>/dev/null || true
    ;;

  status)
    echo "仓库版本:   v$(repo_ver)"
    echo "已装版本:   v$(inst_ver)   ($EXT_DIR)"
    printf "运行版本:   "; "$CB" version 2>/dev/null || echo "扩展没连上"
    printf "连接状态:   "; "$CB" status 2>/dev/null || echo "宿主没在跑"
    ;;

  reload)
    "$CB" reload
    ;;

  logs)
    echo "── 扩展日志 ──"
    "$CB" logs --limit 40 2>/dev/null || echo "(拿不到)"
    echo
    echo "── 宿主日志（最近 20 行）──"
    tail -20 /tmp/dsh-bridge.log 2>/dev/null || echo "(没有)"
    ;;

  test)
    echo "── 0. 自动安装（假 HOME，不碰真实环境）──"
    node "$REPO/scratch/test-setup.mjs" || exit 1
    echo
    echo "── 1. 连接 ──";      "$CB" status
    echo "── 2. 扩展版本 ──";  "$CB" version
    echo "── 3. 标签页 ──";    "$CB" tabs | head -3

    # 挑一个 http/https 的标签页（chrome:// 页面 CDP 进不去）
    TID=$("$CB" tabs --json 2>/dev/null | python3 -c "
import json,sys
try: tabs = json.load(sys.stdin)
except Exception: tabs = []
ok = [t for t in tabs if t['url'].startswith(('http://','https://'))]
print(ok[0]['id'] if ok else '')")

    if [ -z "$TID" ]; then
      echo "── 4-6 跳过：没有可用的 http/https 标签页 ──"
      exit 0
    fi

    echo "── 4. 读标题（tab ${TID}）──"
    "$CB" eval "$TID" "document.title" 2>&1 | head -1
    echo "── 5. 读正文前 80 字 ──"
    "$CB" text "$TID" --limit 80 2>&1 | head -3
    echo "── 6. 截图 + 光标 ──"
    "$CB" cursor "$TID" move 300 240 >/dev/null 2>&1
    "$CB" shot "$TID" --out /tmp/dsh-selftest.png >/dev/null 2>&1
    if [ -f /tmp/dsh-selftest.png ]; then
      echo "/tmp/dsh-selftest.png  $(wc -c < /tmp/dsh-selftest.png | tr -d ' ') bytes"
    else
      echo "截图失败"
    fi
    ;;

  pack)
    # 发版用：打出 npm 风格的 tgz（package/ 前缀），附加到 GitHub Release
    OUT="/tmp/dsh-chrome-bridge.tgz"
    rm -f "$OUT"
    ( cd "$REPO/plugin" && tar -czf "$OUT" -s ',^,package/,' package.json index.js setup.js image-guard.js cordis.patch.yml icon.svg vendor )
    echo "打包完成 ${OUT}（$(wc -c < "$OUT" | tr -d ' ') bytes）"
    echo "发版时记得附加（资产名必须不带版本号，目录条目用的是 latest/download）："
    echo "  gh release upload <tag> ${OUT} --clobber"
    ;;

  store-pack)
    # 上架 Chrome 应用商店用：只打扩展本体，并且去掉 manifest 里的 key
    # （商店会分配自己的 item ID，key 只在「加载已解压」时用来固定 ID）
    OUT="$REPO/dist/dsh-bridge-store.zip"
    TMP="$(mktemp -d)"
    trap 'rm -rf "$TMP"' EXIT
    cp -R "$VENDOR/extension/." "$TMP/"
    node -e '
      const fs = require("fs"), p = process.argv[1];
      const m = JSON.parse(fs.readFileSync(p, "utf8"));
      delete m.key;
      fs.writeFileSync(p, JSON.stringify(m, null, 2) + "\n");
    ' "$TMP/manifest.json"
    mkdir -p "$REPO/dist"
    rm -f "$OUT"
    ( cd "$TMP" && zip -qr "$OUT" . -x '.*' )
    ver="$(node -e 'console.log(require(process.argv[1]).version)' "$TMP/manifest.json")"
    echo "商店包：${OUT}（扩展 v${ver}，$(wc -c < "$OUT" | tr -d ' ') bytes，manifest 已去掉 key）"
    echo "zip 内容："
    ( cd "$TMP" && find . -type f | sed 's|^\./|  |' | sort )
    echo
    echo "上架前把 listing 文案填进开发者后台：$REPO/store/listing.md"
    echo "上架后拿到 32 位 item ID：回填 allowed_origins（plugin/setup.js 的 STORE_EXT_IDS）再发一版插件"
    ;;

  uninstall)
    exec "$REPO/install.sh" --uninstall
    ;;

  *)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
